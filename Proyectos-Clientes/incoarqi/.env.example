# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Motor de datos activo para los leads: firebase | supabase | local
DB_MOTOR=local

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase (si DB_MOTOR=firebase) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Analítica ---
GA4_ID=

# --- Notificación de nuevo lead (opcional) ---
RESEND_API_KEY=
