# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Motor de datos activo: firebase | supabase | local
DB_MOTOR=supabase

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase (si DB_MOTOR=firebase) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Analítica ---
GA4_ID=

# --- Pagos (opcional) ---
WOMPI_PUBLIC_KEY=
