# ════════════════════════════════════════════════════════════
#  backend-pro · variables de entorno
#
#  ⚠ ESTE ARCHIVO ES DISTINTO A LOS DEMÁS .env DEL SISTEMA.
#  Las variables de las otras bases viajan al navegador. Estas NO:
#  se cargan como SECRETOS de Supabase y viven solo en el servidor.
#
#    supabase secrets set NOMBRE=valor
#
#  Si alguna de estas llega al frontend, alguien puede cobrar y
#  devolver dinero en nombre de tu cliente. No las pegues en un
#  chat, no las subas a Git, no las pongas en la ficha de contexto.
# ════════════════════════════════════════════════════════════

# ── Wompi (las crea EL CLIENTE en comercio.wompi.co) ────────
# Desarrolladores → Llaves API
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxx
# Desarrolladores → Eventos (es OTRO secreto, no el de integridad)
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxx

# ── Supabase ────────────────────────────────────────────────
# Estas dos las inyecta Supabase sola dentro de las Edge Functions.
# Están aquí solo para desarrollo local con `supabase functions serve`.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Dominio del sitio (para CORS) ───────────────────────────
# Pon el dominio real. Con "*" cualquier página puede llamar a tu
# función; funciona, pero es descuidado en un endpoint de pagos.
SITIO_URL=https://tienda-del-cliente.com
