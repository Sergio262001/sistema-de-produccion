# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Motor de datos activo: firebase | supabase | local
DB_MOTOR=supabase

# Proveedor de autenticación del panel: firebase | supabase | local
AUTH_MOTOR=supabase

# --- Supabase (lee las tablas leads/productos de otras bases) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- GA4 (tráfico/visitas — requiere backend, ver README) ---
# Este dashboard NO trae tráfico de GA4 conectado: la GA4 Data API
# necesita una cuenta de servicio que no puede vivir en el frontend.
GA4_PROPERTY_ID=
