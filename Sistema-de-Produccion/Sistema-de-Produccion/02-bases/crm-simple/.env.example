# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Motor de datos activo: firebase | supabase | local
DB_MOTOR=supabase

# Proveedor de autenticación: firebase | supabase | local
AUTH_MOTOR=supabase

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
