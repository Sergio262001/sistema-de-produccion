# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Pasarela de pago activa: whatsapp | wompi | mercadopago | stripe
PAGOS_PROVEEDOR=whatsapp

# --- WhatsApp (si PAGOS_PROVEEDOR=whatsapp) ---
WHATSAPP_NUM=

# --- Wompi ---
# La public key es la única que va al frontend (la usa el widget).
WOMPI_PUBLIC_KEY=
# Privada y secreto de integridad: SOLO en tu backend, nunca en el navegador.
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=

# --- Mercado Pago ---
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# --- Stripe ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
