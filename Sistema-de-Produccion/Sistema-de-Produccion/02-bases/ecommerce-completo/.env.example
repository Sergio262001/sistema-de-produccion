# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Motor de datos activo: firebase | supabase | local
DB_MOTOR=supabase

# Proveedor de autenticación del panel: firebase | supabase | local
AUTH_MOTOR=supabase

# --- Supabase (datos + auth) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase (si DB_MOTOR=firebase o AUTH_MOTOR=firebase) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Pagos: WhatsApp (sin pasarela) o Wompi ---
WHATSAPP_NUM=
# La public key es la única que va al frontend (la usa el widget).
WOMPI_PUBLIC_KEY=
# Privada y secreto de integridad: SOLO en tu backend, nunca en el navegador.
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=

# --- Analítica ---
GA4_ID=
