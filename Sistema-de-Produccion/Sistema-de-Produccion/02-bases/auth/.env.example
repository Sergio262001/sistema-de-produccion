# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Proveedor de autenticación activo: firebase | supabase | local
AUTH_MOTOR=supabase

# --- Supabase Auth ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase Auth (si AUTH_MOTOR=firebase) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
