# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Motor de datos activo: firebase | supabase | local
DB_MOTOR=supabase

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Cobro recurrente real (requiere backend, ver README) ---
# Stripe Billing o Mercado Pago "preapproval" — la API key secreta
# de cualquiera de los dos NUNCA va en el frontend.
STRIPE_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
