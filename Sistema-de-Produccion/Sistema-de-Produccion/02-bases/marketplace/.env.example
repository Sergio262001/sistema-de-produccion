# ── Variables de entorno — copia a .env y rellena ──
# NUNCA subas el .env real a Git (ya está en .gitignore)

# Motor de datos activo: firebase | supabase | local
DB_MOTOR=supabase

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Firebase ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# --- Pagos ---
WHATSAPP_NUM=
# Split automático entre vendedores no está soportado por Wompi.
# Si usas una pasarela con split real (ej. Stripe Connect), sus
# claves van aquí — nunca en el frontend.
